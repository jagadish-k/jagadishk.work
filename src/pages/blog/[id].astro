---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  
  <article class="w-full max-w-6xl mx-auto py-12 md:py-24 reveal-on-scroll">
    
    <header class="mb-16 md:mb-24 flex flex-col items-center text-center">
      <a href="/blog" class="text-zinc-500 hover:text-zinc-900 transition-colors text-sm font-medium inline-flex items-center gap-2 mb-10 group">
        <div class="w-8 h-8 rounded-full bg-zinc-200/50 flex items-center justify-center group-hover:-translate-x-1 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </div>
        Back to Thoughts
      </a>
      
      <div class="flex flex-wrap gap-2 mb-8 justify-center">
        {post.data.categories.map(category => (
          <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="text-[10px] font-semibold uppercase tracking-[0.2em] px-3 py-1 bg-zinc-100 text-zinc-600 rounded-full hover:bg-zinc-900 hover:text-white transition-colors">
            {category}
          </a>
        ))}
      </div>
      
      <h1 class="text-5xl md:text-7xl font-clash font-semibold tracking-tight text-zinc-900 mb-8 max-w-4xl leading-tight">
        {post.data.title}
      </h1>
      
      <time class="text-zinc-400 font-medium font-satoshi" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-us', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>

    <div class="prose prose-zinc prose-lg max-w-none prose-headings:font-clash prose-headings:font-medium prose-p:font-satoshi prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4 markdown-content">
      <Content />
    </div>
    
  </article>

</BaseLayout>
