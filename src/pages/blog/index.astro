---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Blog | ${siteConfig.name}`} description="Technical blog covering Architecture, Design Systems, Performance, and more.">
  <div class="mb-12">
    <a href="/" class="text-stone-500 hover:text-stone-900 transition-colors text-sm font-medium inline-flex items-center gap-1 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back to Home
    </a>
    <h1 class="text-5xl font-serif tracking-tight text-stone-900 mb-4">Technical Blog</h1>
    <p class="text-xl text-stone-600 font-medium">Thoughts on UI Architecture, Design Systems, and Performance.</p>
  </div>

  <div class="space-y-12">
    {sortedPosts.map(post => (
      <article class="group relative">
        <div class="mb-2 flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
          <a href={`/blog/${post.id}`} class="no-underline">
            <h2 class="text-2xl font-semibold text-stone-900 font-serif group-hover:text-stone-600 transition-colors">{post.data.title}</h2>
          </a>
          <time class="text-sm text-stone-500 font-medium font-mono tracking-tight mt-1 sm:mt-0" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-us', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
        </div>
        <div class="flex gap-2 mb-4">
          {post.data.categories.map(category => (
            <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`} class="text-xs font-medium uppercase tracking-widest text-stone-400 hover:text-stone-700 transition-colors">
              {category}
            </a>
          ))}
        </div>
        <p class="text-stone-600 leading-relaxed">
          {post.data.description}
        </p>
        <div class="mt-4">
          <a href={`/blog/${post.id}`} class="text-sm font-medium text-stone-900 hover:underline">Read more →</a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
