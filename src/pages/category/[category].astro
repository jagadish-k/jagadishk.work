---
import BaseLayout from '@portfolio/layouts/BaseLayout.astro';
import { siteConfig } from '@portfolio/config';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Extract all unique categories
  const uniqueCategories = [...new Set(allPosts.flatMap(post => post.data.categories))];
  
  return uniqueCategories.map(category => {
    const filteredPosts = allPosts.filter(post => 
      post.data.categories.includes(category) && !post.data.draft
    ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: category.toLowerCase().replace(/\s+/g, '-') },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { posts, categoryName } = Astro.props;
const getBentoClasses = (index: number) => {
  const pattern = index % 5;
  if (pattern === 0) return "md:col-span-2 lg:col-span-2 md:row-span-2";
  if (pattern === 3) return "md:col-span-2 lg:col-span-3";
  return "col-span-1 row-span-1";
};
---

<BaseLayout title={`${categoryName} | ${siteConfig.name}`} description={`Articles about ${categoryName}`}>
  <div class="mb-16 md:mb-24 reveal-on-scroll">
    <a href="/blog" class="text-zinc-500 hover:text-zinc-900 transition-colors text-sm font-medium inline-flex items-center gap-2 mb-10 group">
      <div class="w-8 h-8 rounded-full bg-zinc-200/50 flex items-center justify-center group-hover:-translate-x-1 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      </div>
      All Posts
    </a>
    <h1 class="text-5xl md:text-7xl font-clash font-semibold tracking-tight text-zinc-900 mb-6 capitalize">{categoryName}</h1>
    <p class="text-xl md:text-2xl text-zinc-500 font-satoshi max-w-2xl leading-relaxed">Found {posts.length} {posts.length === 1 ? 'post' : 'posts'} in this category.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {posts.map((post: any, index: number) => (
      <article class={`group relative reveal-on-scroll w-full ${getBentoClasses(index)}`}>
        
        <div class="bg-black/5 p-2 md:p-[6px] rounded-[2.5rem] border border-black/5 h-full transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1">
          
          <div class="bg-white rounded-[calc(2.5rem-6px)] p-8 md:p-10 h-full flex flex-col justify-between shadow-[0_16px_40px_-12px_rgba(0,0,0,0.05)] border border-black/[0.03]">
            
            <div>
              <div class="flex flex-wrap gap-2 mb-6">
                {post.data.categories.map((cat: string) => (
                  <a href={`/category/${cat.toLowerCase().replace(/\s+/g, '-')}`} class={`text-[10px] font-semibold uppercase tracking-[0.2em] px-3 py-1 rounded-full transition-colors relative z-10 ${cat === categoryName ? 'bg-zinc-900 text-white' : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-200'}`}>
                    {cat}
                  </a>
                ))}
              </div>
              
              <a href={`/blog/${post.id}`} class="absolute inset-0 z-0"><span class="sr-only">Read {post.data.title}</span></a>
              
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-clash font-medium text-zinc-900 mb-4 leading-tight group-hover:text-blue-600 transition-colors">
                {post.data.title}
              </h2>
              
              <p class="text-zinc-500 font-satoshi leading-relaxed md:text-lg mb-8 line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-zinc-100 pt-6 mt-auto">
              <time class="text-sm text-zinc-400 font-medium font-satoshi" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-us', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>

              <div class="inline-flex items-center gap-4 bg-zinc-900 text-white rounded-full pl-6 pr-2 py-2 group-hover:bg-zinc-800 transition-colors relative z-10">
                <span class="text-sm font-semibold tracking-wide">Read Essay</span>
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 group-hover:scale-105 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </div>
              </div>
            </div>
            
          </div>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
