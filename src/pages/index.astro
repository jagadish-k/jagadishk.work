---
import { siteConfig } from '../config';
import MonolithTheme from '../themes/monolith/index.astro';
import KineticTheme from '../themes/kinetic/index.astro';
import NeoBrutalistTheme from '../themes/neo-brutalist/index.astro';
import HorizonTheme from '../themes/horizon/index.astro';
import EditorialTheme from '../themes/editorial/index.astro';
import StructuralTheme from '../themes/structural/index.astro';
import DevThemeSwitcher from '../components/DevThemeSwitcher.astro';

// Read the theme strictly from config for the root page
const requestedTheme = siteConfig.theme;

const getThemeComponent = (theme: string) => {
  switch(theme) {
    case 'editorial': return EditorialTheme;
    case 'structural': return StructuralTheme;
    case 'kinetic': return KineticTheme;
    case 'neo-brutalist': return NeoBrutalistTheme;
    case 'horizon': return HorizonTheme;
    case 'monolith':
    default:
      return MonolithTheme;
  }
};

const Theme = getThemeComponent(requestedTheme);
const isDev = import.meta.env.DEV;
---

<Theme />
{isDev && <DevThemeSwitcher />}
