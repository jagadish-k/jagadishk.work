---
import { siteConfig } from '../config';
import MinimalTheme from '../themes/minimal/index.astro';
import LinearTheme from '../themes/linear/index.astro';
import KeynoteTheme from '../themes/keynote/index.astro';
import EditorialTheme from '../themes/editorial/index.astro';
import SpatialTheme from '../themes/spatial/index.astro';
import BrutalistTheme from '../themes/brutalist/index.astro';
import DevThemeSwitcher from '../components/DevThemeSwitcher.astro';

// Read the theme strictly from config for the root page
const requestedTheme = siteConfig.theme;

const getThemeComponent = (theme: string) => {
  switch(theme) {
    case 'keynote': return KeynoteTheme;
    case 'editorial': return EditorialTheme;
    case 'spatial': return SpatialTheme;
    case 'brutalist': return BrutalistTheme;
    case 'minimal': return MinimalTheme;
    case 'linear':
    default:
      return LinearTheme;
  }
};

const Theme = getThemeComponent(requestedTheme);
const isDev = import.meta.env.DEV;
---

<Theme />
{isDev && <DevThemeSwitcher />}
