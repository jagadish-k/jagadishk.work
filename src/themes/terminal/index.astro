---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#0F1115] text-[#A3B8CC]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --cyan: #00F0FF;
      --lime: #39FF14;
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    body { font-family: 'Space Mono', monospace; }
    
    /* Grid Background */
    .grid-bg {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: 
        linear-gradient(to right, rgba(163,184,204,0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(163,184,204,0.03) 1px, transparent 1px);
      background-size: 2rem 2rem;
    }

    /* Terminal Box */
    .term-box {
      background: rgba(15,17,21,0.8);
      border: 1px solid rgba(163,184,204,0.1);
      backdrop-filter: blur(12px);
      position: relative;
      transition: border-color 0.3s ease;
    }
    .term-box:hover {
      border-color: var(--cyan);
    }
    .term-box::before {
      content: ''; position: absolute; top: 0; left: 0; width: 8px; height: 8px;
      border-top: 1px solid var(--cyan); border-left: 1px solid var(--cyan);
      opacity: 0; transition: opacity 0.3s;
    }
    .term-box:hover::before { opacity: 1; }

    /* Buttons */
    .term-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: var(--cyan);
      border: 1px solid var(--cyan);
      padding: 0.75rem 1.5rem;
      text-transform: uppercase;
      font-weight: 700;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .term-btn:hover {
      background: var(--cyan);
      color: #0F1115;
    }

    /* Blinking Cursor */
    .cursor-blink {
      display: inline-block;
      width: 0.6em;
      height: 1em;
      background-color: var(--cyan);
      animation: blink 1s step-end infinite;
      vertical-align: text-bottom;
      margin-left: 4px;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .prose-terminal p { font-size: 1rem; color: #A3B8CC; line-height: 1.6; margin-bottom: 1.5em; }
  </style>
</head>
<body class="antialiased min-h-[100dvh] relative selection:bg-[var(--cyan)] selection:text-[#0F1115]">
  
  <div class="grid-bg"></div>
  <TopNav />

  <main class="w-full max-w-7xl mx-auto px-4 md:px-8 relative z-10 print:hidden pt-32">
    
    <!-- Hero -->
    <header class="py-24 md:py-32">
      <div class="mb-6 text-[var(--lime)] font-bold text-sm tracking-widest uppercase">
        > SYSTEM.INITIALIZE({basics?.role})
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold mb-8 text-white uppercase" data-scramble="{basics?.name}">
        {basics?.name}
      </h1>
      
      <div class="max-w-3xl text-lg text-[#A3B8CC] leading-relaxed mb-12">
        <SummaryContent />
      </div>
      
      <button onclick="window.print()" class="term-btn">
        [ EXECUTE : DOWNLOAD_CV ]
      </button>
    </header>

    <!-- Projects (Asymmetrical Bento) -->
    <section class="py-24 border-t border-[#A3B8CC]/10">
      <div class="mb-12 flex justify-between items-end">
        <h2 class="text-3xl font-bold text-white uppercase" data-scramble="DATABASE.QUERY(PROJECTS)">
          DATABASE.QUERY(PROJECTS)<span class="cursor-blink"></span>
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[250px]">
        {sortedProjects.map((project, i) => {
          let spanClass = 'md:col-span-4';
          if (i === 0) spanClass = 'md:col-span-8 md:row-span-2';
          else if (i === 1) spanClass = 'md:col-span-4';
          else if (i === 2) spanClass = 'md:col-span-4';
          
          return (
            <a href={project.data.url || '#'} class={`group term-box p-6 flex flex-col justify-between no-underline hover:bg-[var(--cyan)]/5 ${spanClass}`}>
              <div class="flex justify-between items-start mb-4">
                <h3 class="text-xl font-bold text-white uppercase">{project.data.title}</h3>
                <span class="text-xs text-[#A3B8CC]/50">ID:00{i+1}</span>
              </div>
              
              <div class="flex-grow flex items-center justify-center relative overflow-hidden mb-6 opacity-30 group-hover:opacity-100 transition-opacity">
                <div class="absolute inset-0 bg-[#A3B8CC]/10"></div>
                <div class="font-bold text-4xl text-[var(--cyan)] tracking-widest">[{project.data.title.substring(0,3).toUpperCase()}]</div>
              </div>

              <div>
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.data.tags.map(tag => (
                    <span class="px-2 py-0.5 bg-[#A3B8CC]/10 text-[10px] uppercase text-[var(--cyan)]">{tag}</span>
                  ))}
                </div>
                <p class="text-sm text-[#A3B8CC] truncate">{project.data.description}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Experience (Data Tables) -->
    <section class="py-24 border-t border-[#A3B8CC]/10">
      <h2 class="text-3xl font-bold text-white uppercase mb-12" data-scramble="TAIL -F /VAR/LOG/EXPERIENCE">
        TAIL -F /VAR/LOG/EXPERIENCE<span class="cursor-blink"></span>
      </h2>
      
      <div class="flex flex-col gap-8">
        {sortedExperience.map(async (job) => {
          const { Content } = await render(job);
          return (
            <div class="term-box p-6 md:p-10 flex flex-col md:flex-row gap-8">
              <div class="md:w-1/3 shrink-0">
                <div class="text-xs text-[var(--lime)] mb-4">[{job.data.startDate} :: {job.data.endDate}]</div>
                <h3 class="text-2xl font-bold text-white uppercase mb-2">{job.data.company}</h3>
                <div class="text-sm text-[var(--cyan)] uppercase">{job.data.title}</div>
              </div>
              <div class="md:w-2/3 prose prose-terminal max-w-none">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    // Scramble Text Microinteraction
    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*";
    
    document.querySelectorAll('[data-scramble]').forEach(element => {
      let interval = null;
      
      const scramble = (el) => {
        let iteration = 0;
        const originalText = el.dataset.scramble;
        clearInterval(interval);
        
        interval = setInterval(() => {
          el.innerText = originalText.split("").map((letter, index) => {
            if(index < iteration) { return originalText[index]; }
            return letters[Math.floor(Math.random() * 42)];
          }).join("");
          
          if(iteration >= originalText.length) { clearInterval(interval); }
          iteration += 1 / 3;
        }, 30);
      };

      // Trigger on load for hero, and hover for others
      if(element.tagName === 'H1') {
        setTimeout(() => scramble(element), 500);
      }
      
      element.addEventListener('mouseover', () => scramble(element));
    });
  </script>
</body>
</html>
