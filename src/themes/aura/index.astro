---
import '@fontsource/plus-jakarta-sans';
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#050505] text-[#ffffff]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.02em; }
    
    /* Subtle Glowing Emerald Mesh Background */
    .mesh-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.08) 0%, rgba(5,5,5,1) 50%),
                  radial-gradient(circle at 100% 100%, rgba(59, 130, 246, 0.05) 0%, rgba(5,5,5,1) 50%);
      pointer-events: none;
    }

    /* The Double-Bezel Architecture */
    .bezel-outer {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 2.5rem;
      padding: 0.5rem;
      backdrop-filter: blur(24px); /* Valid on fixed/sticky or small non-scrolling elements */
      -webkit-backdrop-filter: blur(24px);
    }
    .bezel-inner {
      background: #080808;
      border-radius: calc(2.5rem - 0.5rem);
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.08);
      height: 100%;
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
    }

    /* Magnetic Button Hover Physics (Microinteractions) */
    .mag-btn-wrapper {
      display: inline-block;
      perspective: 1000px;
    }
    .mag-btn {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      background: white;
      color: black;
      padding: 0.5rem 0.5rem 0.5rem 1.5rem;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 0.875rem;
      transition: transform 400ms var(--cubic-spring);
      cursor: pointer;
    }
    .mag-btn:active {
      transform: scale(0.96); /* Haptic depth */
    }
    /* Button-in-Button Trailing Icon */
    .mag-btn-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      background: rgba(0,0,0,0.05);
      border-radius: 50%;
      transition: all 400ms var(--cubic-spring);
    }
    .mag-btn:hover .mag-btn-icon {
      transform: translate(2px, -2px) scale(1.05); /* Internal kinetic tension */
      background: rgba(0,0,0,0.1);
    }

    .prose-aura p { font-size: 1.125rem; color: rgba(255,255,255,0.6); line-height: 1.6; margin-bottom: 1.5em; }
    
    /* Scroll Reveal Initial State */
    .gsap-reveal { opacity: 0; transform: translateY(40px); }
  </style>
</head>
<body class="font-jakarta antialiased min-h-[100dvh] selection:bg-emerald-500/30 selection:text-white">
  
  <div class="mesh-bg"></div>
  <TopNav />

  <main class="w-full max-w-7xl mx-auto px-4 md:px-8 relative z-10 print:hidden pt-32">
    
    <!-- Hero (Z-Axis Cascade layout approximation) -->
    <header class="py-24 md:py-40 flex flex-col items-center text-center gsap-reveal">
      <div class="bezel-outer inline-block mb-12">
        <div class="bezel-inner !p-3 !px-6 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="text-xs font-bold tracking-[0.2em] uppercase text-white/70">{basics?.role}</span>
        </div>
      </div>
      
      <h1 class="text-[clamp(3rem,8vw,6rem)] font-extrabold leading-[1.1] tracking-tight mb-8 max-w-5xl">
        Architecting <span class="text-white/40">Digital Dimensions</span>
      </h1>
      
      <div class="max-w-2xl text-lg md:text-xl font-medium text-white/50 leading-relaxed mb-12">
        <SummaryContent />
      </div>
      
      <div class="mag-btn-wrapper">
        <button onclick="window.print()" class="mag-btn">
          <span>Download Resumé</span>
          <div class="mag-btn-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </div>
        </button>
      </div>
    </header>

    <!-- Z-Axis Cascade Projects -->
    <section class="py-24 md:py-40">
      <h2 class="text-4xl font-bold mb-16 text-center tracking-tight gsap-reveal">Selected Works</h2>
      <div class="flex flex-col items-center gap-16 md:gap-32">
        {sortedProjects.map((project, i) => {
          // Alternating subtle rotations to break digital grid
          const rotate = i % 2 === 0 ? '-rotate-1' : 'rotate-1';
          const translate = i % 2 === 0 ? 'md:-translate-x-12' : 'md:translate-x-12';
          
          return (
            <a href={project.data.url || '#'} class={`group block w-full max-w-4xl no-underline transform transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.02] hover:z-20 ${rotate} ${translate} gsap-reveal`}>
              <div class="bezel-outer">
                <div class="bezel-inner flex flex-col md:flex-row gap-8 items-center">
                  <div class="w-full md:w-1/2 aspect-video rounded-[1.5rem] overflow-hidden relative">
                    <img src={`https://picsum.photos/seed/aura${i}/800/600`} class="w-full h-full object-cover opacity-60 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" alt="" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#080808] to-transparent opacity-50"></div>
                  </div>
                  <div class="w-full md:w-1/2 p-4">
                    <h3 class="text-3xl font-bold mb-4">{project.data.title}</h3>
                    <p class="text-white/50 text-lg leading-relaxed mb-6">{project.data.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {project.data.tags.map(tag => (
                        <span class="px-3 py-1 bg-white/5 rounded-full text-xs font-bold tracking-widest uppercase text-white/40">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24 md:py-40">
      <h2 class="text-4xl font-bold mb-16 text-center tracking-tight gsap-reveal">Experience</h2>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        {sortedExperience.map(async (job, i) => {
          const { Content } = await render(job);
          // Bento sizing approximation
          const colSpan = i === 0 ? 'md:col-span-12' : 'md:col-span-6';
          return (
            <div class={`bezel-outer ${colSpan} gsap-reveal hover:-translate-y-2 transition-transform duration-700`}>
              <div class="bezel-inner !p-8 md:!p-12">
                <div class="text-xs font-bold tracking-widest text-emerald-500/70 uppercase mb-4">{job.data.startDate} — {job.data.endDate}</div>
                <h3 class="text-2xl md:text-3xl font-bold mb-2">{job.data.company}</h3>
                <div class="text-lg font-medium text-white/40 mb-8">{job.data.title}</div>
                <div class="prose prose-aura max-w-none">
                  <Content />
                </div>
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // Gentle Mass/Spring Scroll Interpolation
    const reveals = document.querySelectorAll('.gsap-reveal');
    reveals.forEach(el => {
      gsap.to(el, {
        y: 0,
        opacity: 1,
        duration: 1.2,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%", // Triggers when top of element hits 85% of viewport
          toggleActions: "play none none none"
        }
      });
    });
  </script>
</body>
</html>
