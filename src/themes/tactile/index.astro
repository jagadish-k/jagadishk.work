---
import '@fontsource/nunito';
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#E0E5EC] text-[#4A5568]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --bg-color: #E0E5EC;
      --shadow-light: #ffffff;
      --shadow-dark: #a3b1c6;
    }
    .font-tactile { font-family: 'Nunito', sans-serif; }
    
    /* Neumorphic Extrusion (Outset) */
    .neu-outset {
      background: var(--bg-color);
      box-shadow: 
        9px 9px 16px var(--shadow-dark), 
        -9px -9px 16px var(--shadow-light);
      border-radius: 20px;
      transition: all 0.3s ease;
    }
    
    /* Neumorphic Depression (Inset) */
    .neu-inset {
      background: var(--bg-color);
      box-shadow: 
        inset 6px 6px 10px 0 var(--shadow-dark),
        inset -6px -6px 10px 0 var(--shadow-light);
      border-radius: 20px;
    }

    /* Neumorphic Text */
    .neu-text {
      color: var(--bg-color);
      text-shadow: 
        2px 2px 4px var(--shadow-dark), 
        -2px -2px 4px var(--shadow-light);
    }
    
    .neu-text-inner {
      color: transparent;
      background-color: #4A5568;
      background-clip: text;
      -webkit-background-clip: text;
      text-shadow: 2px 2px 3px rgba(255,255,255,0.5);
    }

    /* Button Interactions */
    .neu-btn {
      background: var(--bg-color);
      box-shadow: 
        6px 6px 12px var(--shadow-dark), 
        -6px -6px 12px var(--shadow-light);
      border-radius: 50px;
      padding: 1rem 2.5rem;
      font-weight: 800;
      color: #4A5568;
      transition: all 0.2s ease;
      cursor: pointer;
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .neu-btn:hover {
      color: #2D3748;
    }
    .neu-btn:active {
      box-shadow: 
        inset 4px 4px 8px var(--shadow-dark),
        inset -4px -4px 8px var(--shadow-light);
    }

    /* Card Interactions */
    .neu-card {
      padding: 2rem;
    }
    .neu-card:hover {
      box-shadow: 
        12px 12px 20px var(--shadow-dark), 
        -12px -12px 20px var(--shadow-light);
      transform: translateY(-2px);
    }

    .prose-tactile p { color: #4A5568; font-size: 1.1rem; line-height: 1.8; margin-bottom: 1.5rem; }
  </style>
</head>
<body class="font-tactile antialiased min-h-[100dvh] relative selection:bg-[#4A5568] selection:text-white">
  
  <TopNav />

  <main class="w-full relative z-10 print:hidden pt-32 px-4 md:px-12 max-w-screen-xl mx-auto">
    
    <!-- Hero -->
    <header class="py-24 flex flex-col items-center text-center">
      <div class="neu-inset px-6 py-2 rounded-full mb-8 font-bold text-sm tracking-widest text-[#718096] uppercase">
        {basics?.role}
      </div>
      
      <h1 class="text-6xl md:text-8xl lg:text-9xl font-extrabold mb-12 neu-text-inner tracking-tight">
        {basics?.name}
      </h1>
      
      <div class="max-w-2xl text-xl text-[#718096] leading-relaxed mb-16 font-semibold">
        <SummaryContent />
      </div>
      
      <button onclick="window.print()" class="neu-btn">
        Generate PDF
      </button>
    </header>

    <!-- Projects -->
    <section class="py-24">
      <h2 class="text-4xl font-extrabold mb-16 text-center text-[#4A5568]">Selected Projects</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {sortedProjects.map((project, i) => (
          <a href={project.data.url || '#'} class="neu-outset neu-card block group no-underline">
            <div class="neu-inset aspect-video w-full mb-8 p-3 rounded-2xl">
              <img src={`https://picsum.photos/seed/tactile${i}/800/450`} alt="" class="w-full h-full object-cover rounded-xl opacity-90 group-hover:opacity-100 transition-opacity" />
            </div>
            <h3 class="text-2xl font-bold mb-3 text-[#2D3748]">{project.data.title}</h3>
            <p class="text-[#718096] mb-8 font-medium">{project.data.description}</p>
            <div class="flex flex-wrap gap-3">
              {project.data.tags.map(tag => (
                <span class="neu-outset px-4 py-2 rounded-full text-xs font-bold text-[#4A5568] uppercase tracking-wide">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24">
      <h2 class="text-4xl font-extrabold mb-16 text-center text-[#4A5568]">Experience</h2>
      
      <div class="neu-outset p-6 md:p-12">
        {sortedExperience.map(async (job, i) => {
          const { Content } = await render(job);
          const borderClass = i !== sortedExperience.length - 1 ? 'border-b-2 border-white/40 pb-12 mb-12' : '';
          return (
            <div class={`flex flex-col md:flex-row gap-8 ${borderClass}`}>
              <div class="md:w-1/3 shrink-0">
                <div class="neu-inset inline-block px-4 py-1 rounded-full text-xs font-bold text-[#718096] uppercase mb-6">
                  {job.data.startDate} — {job.data.endDate}
                </div>
                <h3 class="text-2xl font-extrabold mb-2 text-[#2D3748]">{job.data.company}</h3>
                <div class="text-[#4A5568] font-bold uppercase tracking-wide">{job.data.title}</div>
              </div>
              <div class="md:w-2/3 prose prose-tactile max-w-none">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

</body>
</html>
