---
import '@fontsource/manrope';
import '@portfolio/styles/global.css';
import { getCollection, render } from 'astro:content';
import LightboxCarousel from '@portfolio/components/LightboxCarousel.astro';
import CVPrintTemplate from '@portfolio/components/CVPrintTemplate.astro';
import TopNav from '@portfolio/components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-white text-black">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    .font-manrope { font-family: 'Manrope', sans-serif; letter-spacing: -0.03em; }

    /* Fluid Morphing Microinteraction */
    .morph-card {
      position: relative;
      overflow: hidden;
      border-radius: 2rem;
      background: #f4f4f4;
      transform: translateZ(0); /* Force GPU */
    }
    .morph-dot {
      position: absolute;
      bottom: 2rem;
      right: 2rem;
      width: 3rem;
      height: 3rem;
      background: black;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      z-index: 10;
      transition: all 600ms var(--cubic-spring);
    }
    .morph-content {
      position: absolute;
      inset: 0;
      background: black;
      color: white;
      border-radius: 2rem;
      clip-path: circle(0px at calc(100% - 3.5rem) calc(100% - 3.5rem));
      transition: clip-path 600ms var(--cubic-spring);
      z-index: 5;
      padding: 3rem;
      display: flex;
      flex-col;
      justify-content: flex-end;
    }
    .morph-card:hover .morph-dot {
      transform: scale(0);
    }
    .morph-card:hover .morph-content {
      clip-path: circle(150% at calc(100% - 3.5rem) calc(100% - 3.5rem));
    }

    /* Absolute Button */
    .absolute-btn {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.5rem 1rem 2rem;
      border-radius: 9999px;
      background: black;
      color: white;
      font-weight: 800;
      font-size: 1rem;
      transition: transform 400ms var(--cubic-spring);
    }
    .absolute-btn:active { transform: scale(0.95); }
    .absolute-btn-icon {
      width: 2.5rem;
      height: 2.5rem;
      background: white;
      color: black;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 400ms var(--cubic-spring);
    }
    .absolute-btn:hover .absolute-btn-icon {
      transform: scale(0.8);
    }

    .prose-absolute p { font-size: 1.125rem; font-weight: 500; color: rgba(0,0,0,0.6); line-height: 1.7; margin-bottom: 1.5em; }
  </style>
</head>
<body class="font-manrope antialiased min-h-[100dvh] relative selection:bg-black selection:text-white">
  
  <TopNav />

  <main class="w-full max-w-7xl mx-auto px-4 md:px-8 relative z-10 print:hidden pt-32">
    
    <!-- Hero (Editorial Split) -->
    <header class="py-24 md:py-48 flex flex-col md:flex-row items-center gap-12">
      <div class="w-full md:w-1/2">
        <h1 class="text-[clamp(4rem,8vw,8rem)] font-extrabold leading-[0.9] tracking-tighter mb-8 text-black">
          {basics?.name}
        </h1>
        <div class="mb-12">
          <span class="px-4 py-2 bg-black text-white rounded-full font-bold uppercase tracking-widest text-xs">
            {basics?.role}
          </span>
        </div>
      </div>
      <div class="w-full md:w-1/2">
        <div class="text-xl md:text-2xl font-medium text-black/60 leading-relaxed mb-12">
          <SummaryContent />
        </div>
        <a href="/docs/Jagadish,%20Kasi%20-%20Resume.pdf" target="_blank" rel="noopener noreferrer"  class="absolute-btn">
          <span>Resumé</span>
          <div class="absolute-btn-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </div>
        </a>
      </div>
    </header>

    <!-- Projects (Morphing Grid) -->
    <section class="py-24 md:py-48 border-t-2 border-black/5">
      <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter mb-24">Works</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedProjects.map((project) => (
          <a href={project.data.url || '#'} class="morph-card aspect-square md:aspect-[4/3] block no-underline group cursor-none">
            <LightboxCarousel images={project.data.images} imageClass="w-full h-full object-cover grayscale mix-blend-multiply opacity-80" containerClass="absolute inset-0 w-full h-full" />
            
            <div class="morph-dot">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
            
            <div class="morph-content flex flex-col justify-end">
              <h3 class="text-4xl font-extrabold mb-4 text-white">{project.data.title}</h3>
              <p class="text-white/70 text-lg mb-8 max-w-md font-medium">{project.data.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map(tag => (
                  <span class="px-3 py-1 bg-white/10 rounded-full text-xs font-bold uppercase tracking-widest text-white/50">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24 md:py-48 border-t-2 border-black/5">
      <h2 class="text-4xl md:text-6xl font-extrabold tracking-tighter mb-24">Experience</h2>
      
      <div class="flex flex-col">
        {sortedExperience.map(async (job) => {
          const { Content } = await render(job);
          return (
            <div class="flex flex-col md:flex-row gap-8 py-16 border-b border-black/5 group hover:pl-8 transition-all duration-500">
              <div class="md:w-1/3">
                <div class="text-xs font-bold uppercase tracking-widest text-black/40 mb-4">{job.data.startDate} — {job.data.endDate}</div>
                <h3 class="text-3xl font-extrabold mb-2">{job.data.company}</h3>
                <div class="font-bold text-black/60">{job.data.title}</div>
              </div>
              <div class="md:w-2/3 prose prose-absolute max-w-none opacity-60 group-hover:opacity-100 transition-opacity duration-500">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

</body>
</html>
