---
import '@fontsource/oswald';
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-black text-white">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --neon-pink: #FF0055;
    }
    .font-oswald { font-family: 'Oswald', sans-serif; text-transform: uppercase; }
    .font-serif { font-family: 'Playfair Display', serif; }
    
    /* Marquee Animation */
    .marquee-container {
      overflow: hidden;
      white-space: nowrap;
      display: flex;
      border-top: 2px solid white;
      border-bottom: 2px solid white;
      padding: 1rem 0;
      background: black;
      color: var(--neon-pink);
    }
    .marquee-content {
      display: inline-block;
      animation: marquee 15s linear infinite;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Snappy Hover Block */
    .chic-block {
      border-bottom: 2px solid white;
      transition: background-color 0s, color 0s; /* Brutalist zero-easing */
      cursor: crosshair;
    }
    .chic-block:hover {
      background-color: white;
      color: black;
    }
    .chic-block:hover .chic-accent {
      color: var(--neon-pink);
    }

    /* Button */
    .chic-btn {
      background: var(--neon-pink);
      color: white;
      font-family: 'Oswald', sans-serif;
      text-transform: uppercase;
      font-size: 1.5rem;
      padding: 1rem 3rem;
      border: 4px solid white;
      transition: all 0.1s steps(2);
    }
    .chic-btn:hover {
      background: white;
      color: black;
      border-color: var(--neon-pink);
      transform: translate(6px, 6px);
      box-shadow: -6px -6px 0 var(--neon-pink);
    }
    .chic-btn:active {
      transform: translate(0, 0);
      box-shadow: none;
    }
  </style>
</head>
<body class="antialiased min-h-[100dvh] relative selection:bg-[var(--neon-pink)] selection:text-white">
  
  <TopNav />

  <!-- Marquee Header -->
  <div class="fixed top-0 left-0 w-full z-20 pt-20 mix-blend-difference pointer-events-none print:hidden">
    <div class="marquee-container font-oswald text-3xl tracking-widest">
      <div class="marquee-content">
        {Array(10).fill(`${basics?.name} — ${basics?.role} — `).join('')}
      </div>
    </div>
  </div>

  <main class="w-full relative z-10 print:hidden pt-40 px-4 md:px-12 max-w-screen-2xl mx-auto">
    
    <!-- Hero -->
    <header class="py-24 md:py-32 flex flex-col md:flex-row gap-12 justify-between items-start">
      <h1 class="text-[clamp(5rem,10vw,12rem)] font-oswald font-bold leading-[0.8] tracking-tighter w-full md:w-2/3">
        DESIGN <br/>
        <span class="text-[var(--neon-pink)]">MEETS</span> <br/>
        BRUTAL.
      </h1>
      <div class="w-full md:w-1/3 pt-4">
        <div class="font-serif italic text-2xl md:text-3xl leading-snug mb-12 opacity-90">
          <SummaryContent />
        </div>
        <button onclick="window.print()" class="chic-btn">
          PRINT RESUME
        </button>
      </div>
    </header>

    <!-- Projects -->
    <section class="py-24">
      <h2 class="text-6xl md:text-8xl font-oswald font-bold mb-12 border-b-8 border-white pb-4">SELECTED WORKS</h2>
      <div class="flex flex-col border-t-2 border-white">
        {sortedProjects.map((project, i) => (
          <a href={project.data.url || '#'} class="chic-block py-12 md:py-16 px-4 md:px-8 flex flex-col md:flex-row justify-between items-center group no-underline">
            <h3 class="text-5xl md:text-7xl font-oswald font-bold w-full md:w-1/2">{project.data.title}</h3>
            <div class="w-full md:w-1/2 flex justify-between items-center mt-8 md:mt-0">
              <span class="chic-accent font-serif italic text-2xl md:text-3xl max-w-sm">{project.data.description}</span>
              <span class="font-oswald text-xl border-2 border-current px-4 py-1 rounded-full group-hover:bg-[var(--neon-pink)] group-hover:border-[var(--neon-pink)] group-hover:text-white transition-none">
                VIEW
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24">
      <h2 class="text-6xl md:text-8xl font-oswald font-bold mb-12 border-b-8 border-[var(--neon-pink)] pb-4 text-[var(--neon-pink)]">EXPERIENCE</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedExperience.map(async (job) => {
          const { Content } = await render(job);
          return (
            <div class="border-4 border-white p-8 hover:border-[var(--neon-pink)] transition-colors duration-0">
              <div class="font-oswald text-2xl mb-2 text-[var(--neon-pink)]">{job.data.startDate} — {job.data.endDate}</div>
              <h3 class="text-4xl font-oswald font-bold mb-2 uppercase">{job.data.company}</h3>
              <div class="font-serif italic text-2xl mb-8 border-b border-white/30 pb-4">{job.data.title}</div>
              <div class="prose prose-invert prose-p:font-sans prose-p:text-lg max-w-none">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

</body>
</html>
