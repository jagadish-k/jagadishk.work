---
import '@fontsource/outfit';
import '@portfolio/styles/global.css';
import { getCollection, render } from 'astro:content';
import LightboxCarousel from '@portfolio/components/LightboxCarousel.astro';
import CVPrintTemplate from '@portfolio/components/CVPrintTemplate.astro';
import TopNav from '@portfolio/components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    .font-holo { font-family: 'Outfit', sans-serif; }
    
    /* Iridescent Foil Background */
    .holo-bg {
      background-color: #ffffff;
      background-image: 
        radial-gradient(circle at calc(var(--mouse-x, 50%) * 1) calc(var(--mouse-y, 50%) * 1), rgba(255,182,255,0.8), transparent 40%),
        radial-gradient(circle at calc(var(--mouse-x, 50%) * 0.5) calc(var(--mouse-y, 50%) * 1.5), rgba(135,238,255,0.8), transparent 50%),
        radial-gradient(circle at calc(var(--mouse-x, 50%) * 1.5) calc(var(--mouse-y, 50%) * 0.5), rgba(255,248,154,0.8), transparent 60%);
      background-attachment: fixed;
      color: #1a1a2e;
    }

    /* Holographic Glass Card */
    .glass-card {
      background: rgba(255, 255, 255, 0.4);
      backdrop-filter: blur(40px) saturate(150%);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 24px;
      box-shadow: 0 30px 60px -10px rgba(0,0,0,0.05), inset 0 1px 0 rgba(255,255,255,1);
      transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .glass-card:hover {
      background: rgba(255, 255, 255, 0.6);
      transform: translateY(-5px) scale(1.01);
      box-shadow: 0 40px 80px -10px rgba(0,0,0,0.1), inset 0 1px 0 rgba(255,255,255,1);
    }

    /* Holo Text */
    .holo-text {
      background: linear-gradient(120deg, #ff00cc, #3333ff, #00ffcc, #ffcc00);
      background-size: 300% 300%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: holo-gradient 8s ease infinite;
    }
    @keyframes holo-gradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Button */
    .holo-btn {
      background: rgba(255, 255, 255, 0.9);
      color: #1a1a2e;
      border: 1px solid rgba(255, 255, 255, 1);
      border-radius: 999px;
      padding: 1rem 3rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
    }
    .holo-btn:hover {
      transform: scale(1.05);
      background: linear-gradient(120deg, #ff00cc, #3333ff);
      color: white;
      border-color: transparent;
      box-shadow: 0 20px 40px -10px rgba(51, 51, 255, 0.4);
    }

    .prose-holo p { color: rgba(26,26,46,0.8); font-size: 1.125rem; line-height: 1.6; font-weight: 500; margin-bottom: 1.5rem; }
  </style>
</head>
<body class="font-holo holo-bg antialiased min-h-[100dvh] relative selection:bg-[rgba(255,0,204,0.3)] selection:text-[#1a1a2e]" id="holo-body">
  
  <TopNav />

  <main class="w-full relative z-10 print:hidden pt-32 px-4 md:px-8 max-w-screen-xl mx-auto">
    
    <!-- Hero -->
    <header class="py-24 md:py-40 flex flex-col items-center text-center">
      <div class="glass-card px-8 py-3 rounded-full mb-12">
        <span class="font-bold tracking-widest uppercase text-sm">{basics?.role}</span>
      </div>
      
      <h1 class="text-6xl md:text-8xl lg:text-[10rem] font-black tracking-tighter leading-[0.85] mb-12 holo-text pb-4">
        {basics?.name}
      </h1>
      
      <div class="max-w-3xl text-xl md:text-2xl font-medium leading-relaxed mb-16 text-[#1a1a2e]/70">
        <SummaryContent />
      </div>
      
      <a href="/docs/Jagadish,%20Kasi%20-%20Resume.pdf" target="_blank" rel="noopener noreferrer"  class="holo-btn">
        Experience Resume
      </a>
    </header>

    <!-- Projects -->
    <section class="py-24">
      <h2 class="text-5xl font-black mb-16 text-center tracking-tight">Visions</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedProjects.map((project) => (
          <a href={project.data.url || '#'} class="glass-card p-4 block group no-underline flex flex-col justify-between">
            <div>
              <div class="aspect-square w-full mb-8 rounded-2xl overflow-hidden relative">
                <div class="absolute inset-0 bg-gradient-to-tr from-white/20 to-transparent z-10 pointer-events-none"></div>
                <LightboxCarousel images={project.data.images} imageClass="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" containerClass="absolute inset-0 w-full h-full" />
              </div>
              <h3 class="text-2xl font-black mb-3">{project.data.title}</h3>
              <p class="text-[#1a1a2e]/60 font-medium mb-8 leading-relaxed">{project.data.description}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map(tag => (
                <span class="px-3 py-1 bg-white/40 border border-white/60 rounded-full text-xs font-bold tracking-wider">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24">
      <h2 class="text-5xl font-black mb-16 text-center tracking-tight">Timeline</h2>
      
      <div class="flex flex-col gap-8">
        {sortedExperience.map(async (job) => {
          const { Content } = await render(job);
          return (
            <div class="glass-card p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
              <div class="md:w-1/3 shrink-0">
                <div class="text-xs font-black tracking-widest uppercase mb-4 text-[#1a1a2e]/50">{job.data.startDate} — {job.data.endDate}</div>
                <h3 class="text-3xl font-black mb-2">{job.data.company}</h3>
                <div class="holo-text font-bold tracking-wide text-lg inline-block">{job.data.title}</div>
              </div>
              <div class="md:w-2/3 prose prose-holo max-w-none">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    // Mouse tracking for iridescent background
    const body = document.getElementById('holo-body');
    if (body) {
      document.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth) * 100;
        const y = (e.clientY / window.innerHeight) * 100;
        body.style.setProperty('--mouse-x', `${x}%`);
        body.style.setProperty('--mouse-y', `${y}%`);
      });
    }
  </script>
</body>
</html>
