---
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-black text-[#00ff41]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
  <style>
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    
    .brutalist-border {
      border: 2px solid #00ff41;
      border-radius: 0;
    }
    
    .brutalist-shadow {
      box-shadow: 4px 4px 0px 0px #00ff41;
      transition: all 0.1s ease-in-out;
    }
    
    .brutalist-shadow:hover {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0px 0px #00ff41;
    }

    /* Glitch effect on hover for headings */
    .glitch-hover:hover {
      animation: glitch-skew 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite;
      color: #fff;
    }
    
    @keyframes glitch-skew {
      0% { transform: skew(0deg); }
      20% { transform: skew(-20deg); }
      40% { transform: skew(20deg); }
      60% { transform: skew(-10deg); }
      80% { transform: skew(10deg); }
      100% { transform: skew(0deg); }
    }

    ::selection { background: #00ff41; color: black; }
  </style>
</head>
<body class="font-mono antialiased min-h-screen p-4 md:p-8">

  <div class="print:hidden max-w-7xl mx-auto flex flex-col gap-8">
    
    <!-- Top Nav / Marquee -->
    <div class="brutalist-border p-2 overflow-hidden flex whitespace-nowrap bg-[#00ff41] text-black font-bold">
      <div class="animate-[spin_10s_linear_infinite] hidden"></div> <!-- dummy for tailwind -->
      <marquee scrollamount="10">
        SYSTEM ONLINE /// LOGGED IN AS: {basics?.name} /// ROLE: {basics?.role} /// STATUS: READY FOR HIRE /// SYSTEM ONLINE /// LOGGED IN AS: {basics?.name} ///
      </marquee>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- HERO -->
      <header class="brutalist-border brutalist-shadow p-8 md:p-12 md:col-span-8 bg-black flex flex-col justify-center">
        <h1 class="text-4xl md:text-7xl font-extrabold tracking-tighter mb-4 glitch-hover uppercase">
          {basics?.name}
        </h1>
        <h2 class="text-xl border-b-2 border-[#00ff41] pb-4 mb-8 inline-block max-w-max uppercase">
          > {basics?.role}_
        </h2>
        
        <div class="prose prose-invert prose-p:text-[#00ff41] prose-a:text-white hover:prose-a:bg-[#00ff41] hover:prose-a:text-black">
          <SummaryContent />
        </div>
      </header>

      <!-- LINKS / COMMANDS -->
      <div class="brutalist-border brutalist-shadow p-8 md:col-span-4 bg-black flex flex-col gap-4">
        <h3 class="text-xl font-bold uppercase border-b-2 border-[#00ff41] pb-2 mb-4">Execute Commands</h3>
        {basics?.links && Object.entries(basics.links).map(([name, url]) => (
          <a href={`https://${url}`} target="_blank" class="block p-4 border border-[#00ff41] hover:bg-[#00ff41] hover:text-black font-bold transition-colors uppercase">
            ./run {name}.sh
          </a>
        ))}
        <button onclick="window.print()" class="block p-4 border border-[#00ff41] hover:bg-white hover:text-black hover:border-white font-bold transition-colors uppercase text-left mt-auto">
          ./export-cv.pdf
        </button>
      </div>
      
      <!-- PROJECTS -->
      <div class="md:col-span-12">
        <h3 class="text-3xl font-extrabold uppercase mb-6 bg-[#00ff41] text-black p-2 inline-block">Directory: /projects</h3>
      </div>

      {sortedProjects.map(project => (
        <a href={project.data.url || '#'} target="_blank" class="brutalist-border brutalist-shadow p-6 md:col-span-6 bg-black block no-underline group">
          <div class="flex justify-between items-start mb-4 border-b border-[#00ff41]/50 pb-4">
            <h4 class="text-2xl font-bold uppercase group-hover:text-white transition-colors">{project.data.title}</h4>
            <span class="text-sm">[EXEC]</span>
          </div>
          <p class="text-sm leading-relaxed mb-6">{project.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map(tag => (
              <span class="px-2 py-1 bg-[#00ff41]/20 border border-[#00ff41] text-xs font-bold uppercase">{tag}</span>
            ))}
          </div>
        </a>
      ))}

      <!-- EXPERIENCE -->
      <div class="md:col-span-12 mt-12">
        <h3 class="text-3xl font-extrabold uppercase mb-6 bg-[#00ff41] text-black p-2 inline-block">System.Logs(Experience)</h3>
      </div>

      <div class="brutalist-border p-6 md:p-12 md:col-span-12 bg-black">
        <div class="space-y-12">
          {sortedExperience.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="flex flex-col md:flex-row gap-6 md:gap-12 border-b border-[#00ff41]/30 pb-12 last:border-0 last:pb-0">
                <div class="md:w-1/3 shrink-0">
                  <div class="text-sm mb-2 opacity-70">[{job.data.startDate} TO {job.data.endDate}]</div>
                  <h3 class="text-2xl font-bold uppercase glitch-hover">{job.data.company}</h3>
                  <div class="font-bold mt-1 text-white uppercase">{job.data.title}</div>
                </div>
                <div class="md:w-2/3 prose prose-invert prose-p:text-[#00ff41] prose-li:text-[#00ff41] prose-li:marker:text-[#00ff41]">
                  <Content />
                </div>
              </div>
            )
          })}
        </div>
      </div>

    </div>
  </div>

  <!-- PRINT ONLY -->
  <div class="hidden print:block bg-white text-black font-sans">
    <CVPrintTemplate />
  </div>

</body>
</html>
