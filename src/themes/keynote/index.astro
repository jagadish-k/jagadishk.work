---
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');
const skillsList = await getCollection('resume', ({ data }) => data.type === 'skills');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];
const skills = skillsList[0]?.data.categories || {};

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-black text-white">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .font-display { font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif; }
    
    /* Hide scrollbar for horizontal pan */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="font-display antialiased min-h-screen relative selection:bg-white selection:text-black">

  <div class="print:hidden">
    <!-- HERO SECTION (Sticky Stack Card 1) -->
    <section class="sticky-stack-card sticky top-0 min-h-dvh flex items-center justify-center bg-black overflow-hidden px-6">
      <div class="relative z-10 max-w-5xl w-full text-center">
        <h1 class="hero-title text-6xl md:text-9xl font-bold tracking-tighter opacity-0 translate-y-8">
          {basics?.name}
        </h1>
        <p class="hero-subtitle text-2xl md:text-4xl text-white/50 mt-6 tracking-tight font-medium opacity-0 translate-y-8">
          {basics?.role}
        </p>
        <div class="hero-actions mt-12 flex justify-center gap-6 opacity-0 translate-y-8">
          <button onclick="window.print()" class="px-8 py-4 bg-white text-black font-semibold rounded-full hover:scale-95 transition-transform">
            View Resumé
          </button>
        </div>
      </div>
      
      <!-- Ambient Background Glow -->
      <div class="absolute inset-0 z-0 flex items-center justify-center pointer-events-none opacity-50">
        <div class="w-[80vw] h-[80vw] max-w-3xl max-h-3xl bg-blue-600/20 blur-[120px] rounded-full"></div>
      </div>
    </section>

    <!-- ABOUT SECTION (Sticky Stack Card 2) -->
    <section class="sticky-stack-card sticky top-0 min-h-dvh flex items-center justify-center bg-zinc-950 border-t border-white/5 px-6">
      <div class="max-w-4xl w-full">
        <h2 class="text-xs tracking-[0.2em] uppercase text-white/40 mb-12">The Architect</h2>
        <div class="prose prose-invert prose-2xl md:prose-4xl font-medium leading-tight text-white/90">
          <SummaryContent />
        </div>
      </div>
    </section>

    <!-- PROJECTS (Horizontal Pan) -->
    <section id="horizontal-wrap" class="relative overflow-hidden bg-black border-t border-white/10">
      <div id="horizontal-track" class="flex h-dvh items-center pl-6 md:pl-24 w-max">
        
        <div class="w-[80vw] md:w-[40vw] shrink-0 pr-12 md:pr-24">
          <h2 class="text-6xl md:text-8xl font-bold tracking-tighter">Selected<br/>Works</h2>
          <p class="text-xl text-white/50 mt-6">Scroll to explore →</p>
        </div>

        {sortedProjects.map((project, i) => (
          <div class="w-[85vw] md:w-[45vw] shrink-0 h-[60vh] md:h-[70vh] mr-8 md:mr-16 bg-[#1c1c1e] rounded-4xl p-10 md:p-16 flex flex-col justify-between border border-white/10 group relative overflow-hidden">
            <div class="relative z-10">
              <h3 class="text-3xl md:text-5xl font-bold mb-4 group-hover:text-blue-400 transition-colors">{project.data.title}</h3>
              <p class="text-lg md:text-xl text-white/60 leading-relaxed max-w-xl">{project.data.description}</p>
            </div>
            
            <div class="relative z-10 flex flex-wrap gap-3 mt-8">
              {project.data.tags.map(tag => (
                <span class="px-4 py-2 bg-black/50 backdrop-blur-md text-white/80 text-sm font-medium rounded-full border border-white/10">{tag}</span>
              ))}
            </div>

            <!-- Decorative background gradient per card based on index -->
            <div class={`absolute -bottom-32 -right-32 w-96 h-96 blur-[100px] opacity-20 rounded-full ${i % 2 === 0 ? 'bg-blue-500' : 'bg-purple-500'}`}></div>
          </div>
        ))}
        
        <div class="w-24 shrink-0"></div> <!-- Buffer -->
      </div>
    </section>

    <!-- EXPERIENCE (Vertical Scroll) -->
    <section class="min-h-screen bg-zinc-950 py-32 px-6 border-t border-white/10 relative z-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-5xl font-bold tracking-tighter mb-24 text-center">Experience</h2>
        
        <div class="space-y-24">
          {sortedExperience.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="experience-row flex flex-col md:flex-row gap-8 md:gap-16 opacity-0 translate-y-12">
                <div class="md:w-1/3 shrink-0">
                  <h3 class="text-2xl font-bold">{job.data.company}</h3>
                  <div class="text-blue-400 font-medium mt-1">{job.data.title}</div>
                  <div class="text-white/40 text-sm mt-4 font-mono">{job.data.startDate} — {job.data.endDate}</div>
                </div>
                <div class="md:w-2/3 prose prose-invert prose-lg text-white/70 leading-relaxed marker:text-white/30">
                  <Content />
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>

  <div class="hidden print:block">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // Initial Hero Animation
    gsap.to('.hero-title', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.2 });
    gsap.to('.hero-subtitle', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.4 });
    gsap.to('.hero-actions', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.6 });

    // Sticky Stack Logic
    const stackCards = gsap.utils.toArray('.sticky-stack-card') as HTMLElement[];
    if (stackCards.length > 1) {
      stackCards.forEach((card, i) => {
        if (i === stackCards.length - 1) return; // Last card doesn't scale down
        
        ScrollTrigger.create({
          trigger: card,
          start: 'top top',
          endTrigger: stackCards[stackCards.length - 1],
          end: 'top top',
          pin: true,
          pinSpacing: false,
        });

        gsap.to(card, {
          scale: 0.9,
          opacity: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: stackCards[i + 1],
            start: 'top bottom',
            end: 'top top',
            scrub: true,
          },
        });
      });
    }

    // Horizontal Pan Logic
    const wrap = document.getElementById('horizontal-wrap');
    const track = document.getElementById('horizontal-track');
    
    if (wrap && track) {
      const distance = track.scrollWidth - window.innerWidth;
      
      gsap.to(track, {
        x: -distance,
        ease: 'none',
        scrollTrigger: {
          trigger: wrap,
          start: 'top top',
          end: () => `+=${distance}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });
    }

    // Reveal Experience Rows
    const rows = gsap.utils.toArray('.experience-row');
    rows.forEach((row: any) => {
      gsap.to(row, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: row,
          start: 'top 85%',
        }
      });
    });
  </script>
</body>
</html>
