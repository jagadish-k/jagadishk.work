---
import '@fontsource/outfit';
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#f9f9fb] text-[#0f0f11]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    .font-sans { font-family: 'Outfit', -apple-system, sans-serif; letter-spacing: -0.02em; }
    
    /* Double Bezel Card */
    .structural-card {
      background: white;
      border-radius: 2.5rem;
      padding: 3rem;
      box-shadow: 0 20px 60px -15px rgba(0,0,0,0.03), 0 0 0 1px rgba(0,0,0,0.03);
      position: relative;
    }
    
    @media (max-width: 768px) {
      .structural-card {
        padding: 2rem;
        border-radius: 2rem;
        transform: none !important;
        margin-top: 2rem !important;
      }
    }

    /* Button in Button */
    .btn-outer {
      background: #0f0f11;
      color: white;
      border-radius: 9999px;
      padding: 0.5rem 0.5rem 0.5rem 1.5rem;
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      transition: transform 300ms var(--cubic-spring);
    }
    .btn-outer:active { transform: scale(0.97); }
    .btn-inner {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 9999px;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-center;
      transition: transform 300ms var(--cubic-spring);
    }
    .btn-outer:hover .btn-inner {
      transform: translate(2px, -2px) scale(1.1);
      background: white;
      color: black;
    }

    /* Scroll Reveals */
    .cascade-el {
      opacity: 0;
      transform: translateY(4rem);
      will-change: transform, opacity;
    }

    /* Markdown Overrides */
    .prose-structural p { margin-bottom: 1.25em; color: rgba(15,15,17,0.6); }
    .prose-structural h3 { color: #0f0f11; font-weight: 700; margin-bottom: 0.5em; }
    .prose-structural li { margin-bottom: 0.5em; color: rgba(15,15,17,0.6); }
  </style>
</head>
<body class="font-sans antialiased min-h-[100dvh] relative selection:bg-blue-500 selection:text-white">
  
  <TopNav />

  <div class="print:hidden max-w-5xl mx-auto px-4 md:px-8 py-32 md:py-48 overflow-x-hidden">
    
    <!-- Hero / Intro -->
    <header class="mb-32 md:mb-48 cascade-el text-center flex flex-col items-center">
      <div class="inline-flex px-4 py-2 rounded-full bg-white shadow-[0_4px_20px_-5px_rgba(0,0,0,0.05)] border border-black/5 mb-8">
        <span class="text-xs font-bold tracking-[0.1em] uppercase text-black/60">{basics?.role}</span>
      </div>
      <h1 class="text-6xl md:text-[8rem] font-black tracking-tighter text-[#0f0f11] leading-[0.9] mb-12">
        {basics?.name}
      </h1>
      <div class="text-xl md:text-2xl font-medium text-black/50 leading-relaxed max-w-2xl mx-auto mb-16">
        <SummaryContent />
      </div>
      
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/docs/Jagadish,%20Kasi%20-%20Resume.pdf" target="_blank" rel="noopener noreferrer"  class="btn-outer group cursor-pointer border-0">
          <span class="text-sm font-bold uppercase tracking-widest">Resumé</span>
          <div class="btn-inner flex items-center justify-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          </div>
        </a>
      </div>
    </header>

    <!-- Projects (Z-Axis Cascade) -->
    <section class="mb-32 md:mb-48 relative">
      <h2 class="text-6xl font-black tracking-tighter mb-24 text-center text-black/10">Selected Works</h2>
      
      <div class="relative w-full max-w-4xl mx-auto flex flex-col items-center">
        {sortedProjects.map((project, i) => {
          const rotation = i % 2 === 0 ? '-2deg' : '3deg';
          const translateX = i % 2 === 0 ? '-3%' : '3%';
          const zIndex = 10 + i;
          
          return (
            <a 
              href={project.data.url || '#'} 
              target="_blank" 
              class="structural-card w-full max-w-3xl block no-underline group cascade-el"
              style={`transform: rotate(${rotation}) translateX(${translateX}); z-index: ${zIndex}; margin-top: ${i > 0 ? '-4rem' : '0'};`}
            >
              <div class="flex flex-col md:flex-row gap-8 md:gap-12 justify-between items-start">
                <div class="md:w-2/3">
                  <h3 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 group-hover:text-blue-600 transition-colors duration-500">{project.data.title}</h3>
                  <p class="text-lg text-black/50 leading-relaxed mb-8 font-medium">{project.data.description}</p>
                  <div class="flex flex-wrap gap-2">
                    {project.data.tags.map(tag => (
                      <span class="px-3 py-1.5 rounded-full bg-black/5 text-xs font-bold uppercase text-black/60">{tag}</span>
                    ))}
                  </div>
                </div>
                <div class="md:w-1/3 shrink-0 flex justify-end w-full md:w-auto">
                  <div class="w-16 h-16 rounded-full bg-black/5 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-all duration-500 group-hover:scale-110">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-32 md:mb-48 max-w-4xl mx-auto">
      <h2 class="text-6xl font-black tracking-tighter mb-24 text-center text-black/10">Experience</h2>
      
      <div class="structural-card cascade-el !transform-none !mt-0 !p-8 md:!p-16">
        <div class="space-y-16">
          {sortedExperience.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="border-b border-black/5 pb-16 last:border-0 last:pb-0">
                <div class="flex flex-col md:flex-row gap-6 md:gap-16">
                  <div class="md:w-1/3 shrink-0">
                    <div class="inline-flex px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-bold uppercase mb-4">{job.data.startDate} — {job.data.endDate}</div>
                    <h3 class="text-2xl font-extrabold tracking-tight mb-2">{job.data.company}</h3>
                    <div class="font-bold text-black/40 uppercase tracking-wide text-sm">{job.data.title}</div>
                  </div>
                  <div class="md:w-2/3 prose prose-structural text-lg">
                    <Content />
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- Writing -->
    <section class="max-w-4xl mx-auto">
      <h2 class="text-6xl font-black tracking-tighter mb-24 text-center text-black/10">Essays</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedPosts.map(post => (
          <a href={`/blog/${post.id}`} class="structural-card cascade-el block no-underline group !transform-none !mt-0 !p-8 flex flex-col h-full hover:scale-[1.02] transition-transform duration-500">
            <time class="text-xs font-bold uppercase text-black/30 mb-4 block" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-us', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
            <h3 class="text-3xl font-extrabold tracking-tight mb-4 group-hover:text-blue-600 transition-colors duration-300 leading-tight">{post.data.title}</h3>
            <p class="text-black/50 leading-relaxed font-medium mb-8 flex-grow">{post.data.description}</p>
            <div class="flex items-center gap-3 font-bold uppercase text-xs tracking-widest text-black/40 group-hover:text-blue-600 transition-colors mt-auto">
              Read <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    const cascadeElements = gsap.utils.toArray('.cascade-el');
    
    cascadeElements.forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
        }
      });
    });
  </script>
</body>
</html>
