---
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#F0F4F8] text-[#0A1118]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    .font-serif { font-family: 'Playfair Display', serif; }
    .font-sans { font-family: 'Inter', sans-serif; letter-spacing: -0.01em; }
    
    /* Noise Texture Overlay */
    .noise-overlay {
      position: fixed; inset: 0; z-index: 50; pointer-events: none; opacity: 0.04;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    /* Scroll Reveals */
    .reveal-el {
      opacity: 0;
      transform: translateY(2rem);
      will-change: transform, opacity;
    }
    
    .clip-reveal {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 1.2s var(--cubic-spring);
    }
    .clip-reveal.is-visible {
      clip-path: inset(0 0 0 0);
    }

    /* Markdown Overrides */
    .prose-editorial p { margin-bottom: 1.5em; color: rgba(10,17,24,0.75); }
  </style>
</head>
<body class="font-sans antialiased min-h-[100dvh] relative selection:bg-[#0A1118] selection:text-[#F0F4F8]">
  
  <div class="noise-overlay print:hidden"></div>
  <TopNav />

  <div class="print:hidden">
    <!-- Editorial Split Header -->
    <section class="min-h-[100dvh] flex flex-col md:flex-row pt-32 md:pt-0">
      
      <!-- Left: Massive Typography -->
      <div class="w-full md:w-1/2 flex items-center px-6 md:px-16 py-12 md:py-32 sticky top-0 h-auto md:h-screen">
        <div class="reveal-el max-w-xl">
          <div class="inline-block rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-medium border border-black/10 mb-8">
            The Portfolio
          </div>
          <h1 class="font-serif text-6xl md:text-[7rem] leading-[0.9] tracking-tight mb-8">
            {basics?.name}
          </h1>
          <div class="prose prose-xl prose-editorial font-serif leading-relaxed text-black/80">
            <SummaryContent />
          </div>
          
          <div class="mt-16 flex gap-6">
            <button onclick="window.print()" class="group flex items-center gap-4 text-xs font-semibold uppercase tracking-widest hover:opacity-70 transition-opacity">
              <span>View Resumé</span>
              <div class="w-8 h-8 rounded-full border border-black/20 flex items-center justify-center group-hover:bg-black group-hover:text-white transition-all duration-500">
                &darr;
              </div>
            </button>
          </div>
        </div>
      </div>
      
      <!-- Right: Interactive Stack -->
      <div class="w-full md:w-1/2 px-6 md:px-16 py-12 md:py-32 border-t md:border-t-0 md:border-l border-black/10 flex flex-col gap-32">
        
        <!-- Experience List -->
        <div class="reveal-el">
          <h2 class="text-[10px] uppercase tracking-[0.2em] font-semibold text-black/40 mb-12 border-b border-black/10 pb-4">Professional Record</h2>
          
          <div class="space-y-12">
            {sortedExperience.map(async (job) => {
              const { Content } = await render(job);
              return (
                <div class="group cursor-default">
                  <div class="text-xs font-mono text-black/40 mb-2">{job.data.startDate} — {job.data.endDate}</div>
                  <h3 class="font-serif text-3xl md:text-4xl tracking-tight mb-2 group-hover:italic transition-all duration-500">{job.data.company}</h3>
                  <div class="text-[10px] uppercase tracking-widest text-black/60 mb-6">{job.data.title}</div>
                  <div class="prose prose-editorial text-sm max-w-md">
                    <Content />
                  </div>
                </div>
              )
            })}
          </div>
        </div>

        <!-- Projects -->
        <div class="reveal-el">
          <h2 class="text-[10px] uppercase tracking-[0.2em] font-semibold text-black/40 mb-12 border-b border-black/10 pb-4">Selected Works</h2>
          
          <div class="space-y-24">
            {sortedProjects.map((project, i) => (
              <a href={project.data.url || '#'} target="_blank" class="block group no-underline">
                <div class="aspect-[4/3] bg-[#EBE9E4] mb-8 relative overflow-hidden clip-reveal">
                  <div class="absolute inset-0 flex items-center justify-center font-serif text-3xl text-black/20 opacity-100 group-hover:opacity-0 transition-opacity duration-700">Project {i+1}</div>
                  <div class="absolute inset-0 bg-[#111] text-[#FDFBF7] flex items-center justify-center font-serif text-2xl z-10 translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
                    View Project &nearr;
                  </div>
                </div>
                
                <h3 class="font-serif text-3xl md:text-5xl mb-4 group-hover:italic transition-all duration-500">{project.data.title}</h3>
                <p class="text-base text-black/60 leading-relaxed mb-6 max-w-lg">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <span class="text-[10px] uppercase tracking-[0.2em] px-3 py-1.5 border border-black/10 rounded-full">{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Writing -->
        <div class="reveal-el">
          <h2 class="text-[10px] uppercase tracking-[0.2em] font-semibold text-black/40 mb-12 border-b border-black/10 pb-4 flex justify-between">
            <span>Essays & Thoughts</span>
            <a href="/blog" class="hover:text-black text-black/40 transition-colors">View All &rarr;</a>
          </h2>
          
          <div class="space-y-8">
            {sortedPosts.map(post => (
              <a href={`/blog/${post.id}`} class="block group no-underline border-b border-black/5 pb-8 last:border-0">
                <time class="text-xs font-mono text-black/40 mb-3 block" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-us', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                <h3 class="font-serif text-2xl md:text-3xl mb-3 group-hover:italic transition-all duration-500 leading-tight">{post.data.title}</h3>
                <div class="flex items-center gap-2 mt-4 text-[10px] uppercase tracking-[0.2em] font-semibold opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">
                  Read Article &rarr;
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>
  </div>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    const revealElements = gsap.utils.toArray('.reveal-el');
    revealElements.forEach((el: any) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
        }
      });
    });

    const clipElements = gsap.utils.toArray('.clip-reveal');
    clipElements.forEach((el: any) => {
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        onEnter: () => el.classList.add('is-visible')
      });
    });
  </script>
</body>
</html>
