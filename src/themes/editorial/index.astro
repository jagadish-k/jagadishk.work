---
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');
const skillsList = await getCollection('resume', ({ data }) => data.type === 'skills');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];
const skills = skillsList[0]?.data.categories || {};

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#f4f4f0] text-[#1a1a1a]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    .font-serif { font-family: 'Playfair Display', serif; }
    .font-sans { font-family: 'Inter', sans-serif; }
    
    .editorial-border {
      border-top: 1px solid #1a1a1a;
      border-bottom: 1px solid #1a1a1a;
    }
    
    .hover-image-reveal .preview-img {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 0.6s cubic-bezier(0.77, 0, 0.175, 1);
    }
    .hover-image-reveal:hover .preview-img {
      clip-path: inset(0 0 0 0);
    }
  </style>
</head>
<body class="font-sans antialiased min-h-screen relative selection:bg-black selection:text-[#f4f4f0]">

  <div class="print:hidden">
    <!-- Header -->
    <header class="p-6 md:p-12 flex justify-between items-start">
      <div class="font-serif text-2xl font-semibold tracking-tight">{basics?.name}</div>
      <div class="text-right text-sm uppercase tracking-widest font-medium">
        <div>{basics?.role}</div>
        <div class="text-[#1a1a1a]/50 mt-1">{basics?.location}</div>
      </div>
    </header>

    <!-- Hero / Summary -->
    <section class="px-6 md:px-12 py-24 md:py-48 max-w-7xl mx-auto flex flex-col md:flex-row items-end gap-12 md:gap-24">
      <div class="md:w-2/3">
        <h1 class="font-serif text-5xl md:text-8xl leading-[0.9] tracking-tight mb-12">
          Building precise, crafted interfaces.
        </h1>
        <div class="prose prose-xl prose-stone font-serif text-[#1a1a1a]/80 leading-relaxed max-w-3xl">
          <SummaryContent />
        </div>
      </div>
      <div class="md:w-1/3 editorial-border py-6 flex flex-col gap-4 text-sm uppercase tracking-widest font-medium">
        {basics?.links && Object.entries(basics.links).map(([name, url]) => (
          <a href={`https://${url}`} target="_blank" class="hover:italic transition-all">{name} &nearr;</a>
        ))}
        <button onclick="window.print()" class="text-left mt-4 hover:italic transition-all">Resumé &darr;</button>
      </div>
    </section>

    <!-- Projects (Vignette Layout) -->
    <section class="px-6 md:px-12 py-24 max-w-7xl mx-auto">
      <div class="editorial-border py-4 mb-24">
        <h2 class="text-xs uppercase tracking-[0.2em] font-bold">Selected Works</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-y-32 gap-x-12">
        {sortedProjects.map((project, index) => (
          <div class={`md:col-span-8 ${index % 2 === 1 ? 'md:col-start-5' : 'md:col-start-1'} hover-image-reveal group cursor-pointer relative`}>
            <div class="text-xs font-mono mb-4">0{index + 1}</div>
            
            <!-- Imagined Preview Block -->
            <div class="aspect-4/3 bg-[#e8e8e4] relative overflow-hidden mb-8 flex items-center justify-center">
              <div class="font-serif text-4xl text-[#1a1a1a]/20">No Image Provided</div>
              <div class="preview-img absolute inset-0 bg-[#1a1a1a] text-[#f4f4f0] flex items-center justify-center font-serif text-2xl z-10">
                View Project
              </div>
            </div>

            <h3 class="font-serif text-4xl md:text-6xl mb-4 group-hover:italic transition-all">{project.data.title}</h3>
            <p class="text-lg text-[#1a1a1a]/70 leading-relaxed max-w-xl">{project.data.description}</p>
            
            <div class="flex flex-wrap gap-3 mt-6">
              {project.data.tags.map(tag => (
                <span class="text-xs uppercase tracking-widest border border-[#1a1a1a]/20 px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience (Grid List) -->
    <section class="bg-[#1a1a1a] text-[#f4f4f0] px-6 md:px-12 py-32 mt-32">
      <div class="max-w-7xl mx-auto">
        <div class="border-t border-[#f4f4f0]/20 py-4 mb-24">
          <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-[#f4f4f0]/50">Experience</h2>
        </div>

        <div class="flex flex-col">
          {sortedExperience.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="border-b border-[#f4f4f0]/10 py-12 md:py-16 flex flex-col md:flex-row gap-8 md:gap-24 group">
                <div class="md:w-1/4 shrink-0">
                  <div class="text-sm font-mono text-[#f4f4f0]/40 mb-2">{job.data.startDate} — {job.data.endDate}</div>
                  <h3 class="font-serif text-3xl mb-1">{job.data.company}</h3>
                  <div class="text-sm uppercase tracking-widest text-[#f4f4f0]/60">{job.data.title}</div>
                </div>
                <div class="md:w-3/4 prose prose-invert prose-lg font-serif text-[#f4f4f0]/80 leading-relaxed marker:text-[#f4f4f0]/30 transition-opacity group-hover:opacity-100 opacity-70">
                  <Content />
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>
  </div>

  <div class="hidden print:block text-black bg-white">
    <CVPrintTemplate />
  </div>

</body>
</html>
