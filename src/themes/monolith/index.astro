---
import '../../styles/global.css';
import { siteConfig } from '../../config';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';
import SEO from '../../components/SEO.astro';
import '@fontsource/geist';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter(post => !post.data.draft);
const sortedPosts = publishedPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-white text-zinc-900">
<head>
  <SEO title={`${basics?.name} | ${basics?.role}`}>
    <link rel="preload" as="image" href="https://picsum.photos/seed/monolith/800/1000" fetchpriority="high">
  </SEO>
  <style>
    :root {
      --cubic-spring: cubic-bezier(0.32, 0.72, 0, 1);
    }
    .font-sans { font-family: 'Geist', -apple-system, sans-serif; letter-spacing: -0.03em; }
    
    /* Gapless Bento Base */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-auto-flow: dense;
      gap: 0;
    }
    .bento-cell {
      border: 1px solid rgba(0,0,0,0.05);
      background: #ffffff;
      padding: 3rem;
      position: relative;
      overflow: hidden;
      margin: -0.5px; /* Interlocking borders */
      transition: background 500ms var(--cubic-spring);
    }
    .bento-cell:hover { background: #fafafa; }

    @media (max-width: 768px) {
      .bento-grid { display: flex; flex-direction: column; gap: 0; }
      .bento-cell { padding: 2rem; border-left: none; border-right: none; margin: 0; margin-bottom: -1px; }
    }

    /* Scrub Text Effect */
    .scrub-text { color: rgba(0, 0, 0, 0.4); background-clip: text; }
    .scrub-word { opacity: 0.4; transition: opacity 0.1s; }
    
    /* Image Styles */
    .grayscale-img {
      filter: grayscale(100%) contrast(120%) brightness(100%);
      mix-blend-mode: multiply;
      transition: all 700ms var(--cubic-spring);
    }
    .group:hover .grayscale-img { filter: grayscale(0%) contrast(100%) brightness(100%); transform: scale(1.05); }

    /* Button */
    .mono-btn {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem 2.5rem;
      border-radius: 9999px;
      background: #2563eb;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: all 300ms var(--cubic-spring);
      box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.4);
    }
    .mono-btn:hover {
      background: #1d4ed8;
      transform: translateY(-2px);
      box-shadow: 0 15px 30px -5px rgba(37, 99, 235, 0.5);
    }
    .mono-btn:active { transform: scale(0.97); }

    /* Markdown Overrides */
    .prose-monolith p { margin-bottom: 1.5em; color: rgba(0,0,0,0.6); }
  </style>
</head>
<body class="font-sans antialiased relative selection:bg-blue-600 selection:text-white">
  
  <TopNav />

  <main class="overflow-x-hidden w-full max-w-full print:hidden pt-32">
    
    <!-- Hero (Artistic Asymmetry) -->
    <header class="w-full max-w-7xl mx-auto px-6 md:px-12 py-24 md:py-48 relative min-h-[90vh] flex flex-col justify-center">
      <div class="relative z-10 w-full max-w-6xl">
        <h1 class="text-[4rem] md:text-[clamp(5rem,9vw,9rem)] font-extrabold leading-[0.9] tracking-tighter text-zinc-900 mb-12">
          {basics?.name}
        </h1>
        <div class="max-w-2xl text-xl md:text-3xl font-medium text-zinc-500 leading-relaxed scrub-container" id="hero-summary">
          <SummaryContent />
        </div>
        
        <div class="mt-16">
          <button onclick="window.print()" class="mono-btn cursor-pointer border-0">
            Resumé
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Overlapping Artistic Line Art -->
      <div class="absolute bottom-12 md:bottom-24 right-6 md:right-12 w-3/4 md:w-1/2 max-w-lg aspect-[5/7] -z-0 pointer-events-none opacity-90">
        <svg viewBox="0 0 500 700" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" fill="none">
          <!-- Corporate Blue Hoodie Fill (abstract shape) -->
          <path d="M140 200 C 100 350, 120 500, 160 620 C 250 650, 360 630, 420 500 C 450 350, 390 200, 320 180 C 250 160, 180 150, 140 200 Z" fill="#2563eb" fill-opacity="0.1" />
          
          <g stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-900">
            <!-- The Wall -->
            <line x1="50" y1="50" x2="50" y2="650" stroke-width="2" opacity="0.3" stroke-dasharray="12 18" />
            
            <!-- Person Outline (Continuous-esque Line) -->
            <!-- Left shoulder to bottom -->
            <path d="M 280 120 C 220 90, 160 130, 170 200 C 175 240, 190 280, 140 340 C 100 390, 110 500, 130 600" />
            <!-- Right shoulder to bottom -->
            <path d="M 280 120 C 320 150, 350 200, 360 280 C 370 360, 420 420, 380 500 C 360 540, 340 580, 320 600" />
            <!-- Bottom closure -->
            <path d="M 130 600 C 200 620, 250 620, 320 600" />

            <!-- Face opening in hood (3/4 angle) -->
            <path d="M 190 190 C 200 170, 240 160, 260 190 C 280 220, 260 250, 220 250 C 190 250, 180 220, 190 190" stroke-width="3" />
            
            <!-- Glasses (slightly tilted) -->
            <path d="M 195 205 L 220 200 L 220 215 L 190 220 Z" />
            <path d="M 235 200 L 255 195 L 260 210 L 235 215 Z" />
            <path d="M 220 205 L 235 205" stroke-width="2.5"/>
            <path d="M 255 200 L 275 190" stroke-width="2.5"/>
            <path d="M 180 215 L 195 210" stroke-width="2.5"/>

            <!-- Crossed Arms -->
            <path d="M 130 400 C 180 460, 280 470, 360 380" />
            <path d="M 380 390 C 300 480, 180 480, 100 410" />
            
            <!-- Hands tucked -->
            <path d="M 180 450 C 200 480, 250 480, 270 445" />

            <!-- Hoodie details (strings, pocket) -->
            <path d="M 230 250 Q 240 280, 220 310" stroke-width="2.5" />
            <path d="M 250 260 Q 260 290, 240 320" stroke-width="2.5" />
            <path d="M 190 520 C 220 500, 280 500, 310 520 C 310 550, 280 580, 250 580 C 220 580, 190 550, 190 520 Z" stroke-width="2.5" />
            
            <!-- Wrinkles/Folds -->
            <path d="M 160 320 C 170 340, 190 350, 210 340" stroke-width="2" opacity="0.6"/>
            <path d="M 340 330 C 320 340, 300 350, 290 330" stroke-width="2" opacity="0.6"/>
          </g>
        </svg>
      </div>
    </header>

    <!-- Gapless Bento Grid -->
    <section class="py-24 md:py-48 border-t border-zinc-200 relative z-10 bg-white">
      <div class="max-w-7xl mx-auto px-6 md:px-12 mb-24 flex items-end justify-between">
        <h2 class="text-[clamp(3rem,5vw,5rem)] font-extrabold tracking-tighter leading-none text-zinc-400">Selected<br/>Works</h2>
      </div>
      
      <div class="w-full bento-grid max-w-[1440px] mx-auto border border-zinc-200">
        {sortedProjects.map((project, i) => {
          let spanClass = 'md:col-span-6';
          if (i === 0) spanClass = 'md:col-span-8 md:row-span-2';
          else if (i === 1) spanClass = 'md:col-span-4';
          else if (i === 2) spanClass = 'md:col-span-4';
          
          return (
            <a href={project.data.url || '#'} class={`group bento-cell no-underline flex flex-col justify-between min-h-[400px] ${spanClass}`}>
              <div class="flex justify-between items-start mb-16 relative z-10">
                <h3 class="text-3xl md:text-5xl font-extrabold tracking-tight text-zinc-800 group-hover:text-blue-600 transition-colors duration-300">{project.data.title}</h3>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-300 group-hover:text-blue-600 transition-colors duration-500 shrink-0"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
              </div>
              
              <div class="relative z-10">
                <p class="text-lg text-zinc-500 leading-relaxed mb-8 max-w-md">{project.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map(tag => (
                    <span class="px-3 py-1 bg-zinc-100 text-[10px] font-bold tracking-[0.1em] uppercase text-zinc-600">{tag}</span>
                  ))}
                </div>
              </div>
              
              <!-- Subtle Hover Image Injection -->
              <div class="absolute inset-0 opacity-0 group-hover:opacity-5 transition-opacity duration-700 pointer-events-none">
                <img src={`https://picsum.photos/seed/proj${i}/800/800`} alt="" class="w-full h-full object-cover grayscale-img" loading="lazy" decoding="async" width="800" height="800" />
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Experience Accordion -->
    <section class="py-24 md:py-48 border-t border-zinc-200">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <h2 class="text-[clamp(3rem,5vw,5rem)] font-extrabold tracking-tighter leading-none text-zinc-400 mb-24">Experience</h2>
        
        <div class="flex flex-col border-t border-zinc-200">
          {sortedExperience.map(async (job) => {
            const { Content } = await render(job);
            return (
              <div class="group border-b border-zinc-200 flex flex-col md:flex-row py-12 md:py-16 hover:bg-zinc-50 transition-colors duration-500 px-6 -mx-6">
                <div class="md:w-1/3 shrink-0 mb-8 md:mb-0">
                  <div class="text-[10px] font-mono text-blue-600 mb-4 font-semibold">{job.data.startDate} — {job.data.endDate}</div>
                  <h3 class="text-3xl font-extrabold tracking-tight text-zinc-900 mb-2">{job.data.company}</h3>
                  <div class="text-sm font-semibold tracking-wide text-zinc-500">{job.data.title}</div>
                </div>
                <div class="md:w-2/3 prose prose-monolith text-lg max-w-2xl opacity-70 group-hover:opacity-100 transition-opacity duration-500">
                  <Content />
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    // GSAP Text Scrubbing Logic
    // We target paragraphs inside .scrub-container and wrap words in spans
    const scrubContainers = document.querySelectorAll('.scrub-container p');
    scrubContainers.forEach(p => {
      const text = p.textContent || '';
      const words = text.split(' ');
      p.innerHTML = '';
      words.forEach(word => {
        const span = document.createElement('span');
        span.textContent = word + ' ';
        span.className = 'scrub-word';
        p.appendChild(span);
      });
      
      const spans = p.querySelectorAll('.scrub-word');
      gsap.to(spans, {
        opacity: 1,
        stagger: 0.1,
        scrollTrigger: {
          trigger: p,
          start: 'top 80%',
          end: 'bottom 40%',
          scrub: true
        }
      });
    });
  </script>
</body>
</html>
