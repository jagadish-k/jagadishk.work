---
import '@fontsource/plus-jakarta-sans';
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import CVPrintTemplate from '../../components/CVPrintTemplate.astro';
import TopNav from '../../components/TopNav.astro';

const basicsList = await getCollection('resume', ({ data }) => data.type === 'basics');
const summaryList = await getCollection('resume', ({ data }) => data.type === 'summary');

const basics = basicsList[0]?.data;
const summaryObj = summaryList[0];

const allExperience = await getCollection('experience');
const sortedExperience = allExperience.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const { Content: SummaryContent } = summaryObj ? await render(summaryObj) : { Content: () => null };
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#F0F5F9] text-[#1A2C38]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{basics?.name} | {basics?.role}</title>
  <style>
    :root {
      --liquid-ease: cubic-bezier(0.4, 0, 0.2, 1);
    }
    .font-liquid { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.02em; }
    
    /* Iridescent Ambient Orbs */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 0;
      pointer-events: none;
      animation: float 20s infinite ease-in-out alternate;
    }
    .orb-1 { top: -10%; left: -10%; width: 50vw; height: 50vw; background: rgba(147, 197, 253, 0.4); animation-delay: 0s; }
    .orb-2 { bottom: -20%; right: -10%; width: 60vw; height: 60vw; background: rgba(196, 181, 253, 0.3); animation-delay: -5s; }
    .orb-3 { top: 40%; left: 30%; width: 40vw; height: 40vw; background: rgba(167, 243, 208, 0.2); animation-delay: -10s; }
    
    @keyframes float {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(5%, 10%) scale(1.1); }
    }

    /* Soft Liquid Cards */
    .liquid-card {
      background: rgba(255,255,255,0.4);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 40px;
      transition: all 0.6s var(--liquid-ease);
    }
    .liquid-card:hover {
      background: rgba(255,255,255,0.7);
      transform: translateY(-5px);
      box-shadow: 0 30px 60px -15px rgba(0,0,0,0.05);
    }

    /* SVG Filter Image Hover */
    .fluid-img-container {
      overflow: hidden;
      border-radius: 30px;
      position: relative;
    }
    .fluid-img {
      transition: all 1.2s var(--liquid-ease);
      filter: url('#water');
    }
    .liquid-card:hover .fluid-img {
      transform: scale(1.05);
      /* GSAP handles the feTurbulence baseFrequency animation */
    }

    /* Liquid Button */
    .liquid-btn {
      background: linear-gradient(135deg, #93C5FD, #C4B5FD);
      color: white;
      padding: 1.2rem 2.5rem;
      border-radius: 999px;
      font-weight: 700;
      position: relative;
      overflow: hidden;
      transition: transform 0.4s var(--liquid-ease), box-shadow 0.4s var(--liquid-ease);
    }
    .liquid-btn:hover {
      transform: scale(1.02);
      box-shadow: 0 15px 30px -10px rgba(196, 181, 253, 0.6);
    }
    .liquid-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.4), transparent);
      transform: translateX(-100%) skewX(-15deg);
      transition: transform 0.8s var(--liquid-ease);
    }
    .liquid-btn:hover::after {
      transform: translateX(100%) skewX(-15deg);
    }

    .prose-liquid p { color: rgba(26,44,56,0.7); font-size: 1.125rem; line-height: 1.7; font-weight: 400; margin-bottom: 1.5rem; }
  </style>
</head>
<body class="font-liquid antialiased min-h-[100dvh] relative selection:bg-[#93C5FD] selection:text-[#1A2C38]">
  
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  
  <TopNav />

  <!-- Hidden SVG for Water Distortion Filter -->
  <svg style="width:0;height:0;position:absolute;">
    <filter id="water" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0" numOctaves="1" result="noise" class="water-turb" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="30" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <main class="w-full relative z-10 print:hidden pt-32 px-4 md:px-8 max-w-screen-xl mx-auto">
    
    <!-- Hero -->
    <header class="py-24 md:py-40 flex flex-col items-center text-center">
      <div class="mb-8 bg-white/50 backdrop-blur-md px-6 py-2 rounded-full border border-white font-semibold text-[#1A2C38]/60 uppercase tracking-widest text-xs">
        {basics?.role}
      </div>
      <h1 class="text-[clamp(4rem,8vw,7rem)] font-bold tracking-tighter leading-[1.05] mb-12 text-transparent bg-clip-text bg-gradient-to-br from-[#1A2C38] to-[#6B7280]">
        {basics?.name}
      </h1>
      <div class="max-w-2xl text-xl text-[#1A2C38]/70 leading-relaxed mb-16 font-light">
        <SummaryContent />
      </div>
      <a href="/docs/Jagadish,%20Kasi%20-%20Resume.pdf" target="_blank" rel="noopener noreferrer"  class="liquid-btn">
        Discover Profile
      </a>
    </header>

    <!-- Projects -->
    <section class="py-24 md:py-32">
      <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center text-[#1A2C38]/90">Fluid Works</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        {sortedProjects.map((project, i) => (
          <a href={project.data.url || '#'} class="liquid-card p-4 block group no-underline liquid-trigger">
            <div class="fluid-img-container aspect-[4/3] w-full mb-8">
              <img src={`https://picsum.photos/seed/liquid${i}/800/600`} alt="" class="fluid-img w-full h-full object-cover" />
            </div>
            <div class="px-4 pb-4">
              <h3 class="text-3xl font-bold mb-4">{project.data.title}</h3>
              <p class="text-[#1A2C38]/60 mb-8 line-clamp-2">{project.data.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map(tag => (
                  <span class="px-3 py-1 bg-white/60 border border-white rounded-full text-xs font-semibold text-[#1A2C38]/50">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="py-24 md:py-32">
      <h2 class="text-4xl md:text-5xl font-bold mb-16 text-center text-[#1A2C38]/90">Flow of Experience</h2>
      
      <div class="flex flex-col gap-8">
        {sortedExperience.map(async (job) => {
          const { Content } = await render(job);
          return (
            <div class="liquid-card p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
              <div class="md:w-1/3 shrink-0">
                <div class="text-[#93C5FD] font-bold text-sm tracking-widest uppercase mb-4">{job.data.startDate} — {job.data.endDate}</div>
                <h3 class="text-2xl font-bold mb-2">{job.data.company}</h3>
                <div class="text-[#1A2C38]/50 font-semibold">{job.data.title}</div>
              </div>
              <div class="md:w-2/3 prose prose-liquid max-w-none">
                <Content />
              </div>
            </div>
          )
        })}
      </div>
    </section>

  </main>

  <div class="hidden print:block bg-white text-black">
    <CVPrintTemplate />
  </div>

  <script>
    import { gsap } from 'gsap';

    // SVG Ripple Effect on Hover
    const cards = document.querySelectorAll('.liquid-trigger');
    const turbulences = document.querySelectorAll('.water-turb'); // Only one filter shared, but let's animate it globally on any card hover for simplicity, or create separate filters if needed.
    // For simplicity, animating the single global filter when any card is hovered.
    
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        gsap.to('.water-turb', {
          attr: { baseFrequency: '0.015 0.015' },
          duration: 1,
          ease: 'power2.out'
        });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to('.water-turb', {
          attr: { baseFrequency: '0 0' },
          duration: 1.5,
          ease: 'power2.out'
        });
      });
    });
  </script>
</body>
</html>
