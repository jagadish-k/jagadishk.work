<style is:global>
  .corner-pet {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 50;
    transform-origin: bottom center;
  }
</style>

<SpritePet
  spriteSheetUrl="/assets/pixie-sprite.png"
  frames={catFrames}
  activities={catActivities}
  fps={6}
  class="corner-pet print:hidden"
  transition:persist="pixie-pet"
/>
