---
import SpritePet from "./SpritePet.astro";
import { generateGridFrames } from "../utils/sprite-utils";

const catFrames = generateGridFrames(9, 12, 160, 140);

const catActivities = {
  act1: [0, 1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14, 15, 16],
};
---

<style is:global>
  .corner-pet {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    z-index: 50;
    transform-origin: bottom center;
  }
</style>

<SpritePet
  spriteSheetUrl="/assets/pixie-sprite.png"
  frames={catFrames}
  activities={catActivities}
  fps={6}
  class="corner-pet print:hidden"
  transition:persist="pixie-pet"
/>
