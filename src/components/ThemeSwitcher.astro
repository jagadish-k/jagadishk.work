---
import { siteConfig, themes } from "../config";

// Automatically detect the current theme from the URL path if on a theme page
const currentPath = Astro.url.pathname;
const urlTheme = currentPath.startsWith('/theme/') ? currentPath.split('/')[2] : null;
const { currentTheme = urlTheme || siteConfig.theme } = Astro.props;
---

<div id="theme-switcher-menu" class="absolute bottom-28 right-0 z-[10000] print:hidden opacity-0 pointer-events-none transform translate-y-4 transition-all duration-300">
  <div
    class="bg-black/90 backdrop-blur-md border border-white/20 p-4 rounded-3xl shadow-2xl flex flex-col gap-3 w-[320px]"
  >
    <div class="flex items-center justify-between mb-1 pb-2 border-b border-white/10">
      <span
        class="text-xs font-mono text-white/70 uppercase tracking-widest font-bold"
        >Theme Switcher</span
      >
      <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
    </div>

    <div class="grid grid-cols-2 gap-2 max-h-[50vh] overflow-y-auto pr-1">
      {
        themes.map((theme) => (
          <a
            href={`/theme/${theme.id}`}
            class={`px-3 py-2 text-sm font-medium rounded-xl transition-all border border-transparent flex items-center justify-between group ${currentTheme === theme.id ? "bg-white text-black border-white" : "text-white/70 hover:bg-white/10 hover:text-white hover:border-white/20"}`}
          >
            {theme.name.split(' (')[0]}
            {currentTheme === theme.id && <span class="w-1.5 h-1.5 rounded-full bg-black"></span>}
          </a>
        ))
      }
    </div>
  </div>
</div>
