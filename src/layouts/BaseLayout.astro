---
import "../styles/global.css";
import "@fontsource/bangers";
import "@fontsource/londrina-sketch";
import { siteConfig } from "../config";
import { ClientRouter } from "astro:transitions";
import CurtainTransition from "../components/CurtainTransition.astro";
// import PixiePet from "../components/PixiePet.astro";
import SEO from "../components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = `${siteConfig.name} | ${siteConfig.role}`,
  description = "Portfolio",
  image,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
    />

    <ClientRouter />
    <style is:global>
      .font-serif,
      .font-clash {
        font-family: "Londrina Sketch", sans-serif;
      }
      .font-sans,
      .font-satoshi {
        font-family: "Bangers", sans-serif;
      }

      /* Reveal Animation Classes */
      .reveal-on-scroll {
        opacity: 0;
        filter: blur(8px);
        transform: translateY(3rem);
        transition: all 1s cubic-bezier(0.32, 0.72, 0, 1);
        will-change: transform, opacity, filter;
      }
      .reveal-on-scroll.is-visible {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0);
      }
    </style>
  </head>
  <body
    class="font-sans antialiased bg-[#FAFAFA] text-zinc-900 selection:bg-zinc-200 selection:text-zinc-900 relative min-h-screen z-0"
  >
    <CurtainTransition />

    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24">
      <slot />
    </div>

    <!-- <div class="print:hidden">
      <PixiePet />
    </div> -->

    <section class="pet-showcase">
      <script>
        // Cast the element as an HTMLElement so TS knows its specific properties
        const magneticBtn = document.querySelector(
          ".magnetic-btn",
        ) as HTMLElement;

        if (magneticBtn) {
          // Explicitly type the event 'e' as a MouseEvent
          magneticBtn.addEventListener("mousemove", (e: MouseEvent) => {
            const rect = magneticBtn.getBoundingClientRect();
            const x = (e.clientX - rect.left - rect.width / 2) * 0.3;
            const y = (e.clientY - rect.top - rect.height / 2) * 0.3;

            magneticBtn.style.transform = `translate(${x}px, ${y}px)`;
          });

          magneticBtn.addEventListener("mouseleave", () => {
            magneticBtn.style.transform = `translate(0px, 0px)`;
          });
        }

        // Intersection Observer for the elegant scroll-reveal micro-interaction
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );

        document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
          observer.observe(el);
        });
      </script>
    </section>
  </body>
</html>
